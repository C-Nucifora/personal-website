# Copy to .env.local. Never commit real values.
# Canonical deployed HTTPS origin, without a path. Local development accepts http://localhost:3000.
SITE_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App; callback is SITE_URL/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Neon PostgreSQL connection string, including sslmode=require
DATABASE_URL=
# Optional. Public Vercel Blob store. Existing HTTPS image URLs work without it.
BLOB_READ_WRITE_TOKEN=
